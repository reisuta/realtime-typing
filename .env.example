# realtime-typing — ローカル設定。
# .env（gitignore 対象）にコピーして使う。全ての値は任意で、以下の既定値は .env が
# 無いときにバイナリが使う値そのもの。よってローカル対戦に設定は不要。同じバイナリが
# クラウドでもこれらを読む。

# Go サーバーが待ち受けるポート。
PORT=8080

# bind アドレス。0.0.0.0 にすると LAN / Tailscale の相手が
# http://<あなたのTailscale IP>:8080 で接続できる。完全にローカルだけにするなら 127.0.0.1。
BIND_ADDR=0.0.0.0

# 許可する WebSocket Origin（カンマ区切り）。空なら許容（permissive）で、
# ローカル / Tailscale 対戦ではこれでよい（ページとソケットが同一オリジン）。
# 公開デプロイ時は固定する。例: ALLOWED_ORIGINS=https://typing.example.com
ALLOWED_ORIGINS=

# WebSocket 同時接続数の上限（DoS 対策）。
MAX_CONNS=200
