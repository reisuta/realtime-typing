# サプライチェーン対策。
# 依存のライフサイクルスクリプト（postinstall 等）は決して実行しない。インストール
# 時の任意コード実行（RCE）の主要経路であり、本プロジェクトのビルドツールはどれも
# これを必要としない。
ignore-scripts=true
# インストールはコミット済みの pnpm-lock.yaml と完全一致させる（整合性ハッシュで
# 固定・再現可能）。lockfile がずれている場合は、別バージョンを黙って引く代わりに
# インストールを失敗させる。
frozen-lockfile=true
# peer 依存をレジストリから自動インストールしない。依存ツリーを明示的に保つ。
auto-install-peers=true
